# Settings for one gateway deployment. Edit, then before every command:
#   source gateway.env
# Holds no secrets: credentials come from `aws login` / SSO, and the gateway's
# own secrets live in SSM Parameter Store.

# Remove credentials that would silently win over AWS_PROFILE. A JupyterHub or
# CI runner often injects its own role (AWS_ROLE_ARN + web identity token), and
# AWS_BEARER_TOKEN_BEDROCK is a Bedrock API key that sends Bedrock calls to
# whichever account made it. Delete this line only if you mean to use one of them.
unset AWS_ROLE_ARN AWS_WEB_IDENTITY_TOKEN_FILE AWS_ROLE_SESSION_NAME \
      AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \
      AWS_BEARER_TOKEN_BEDROCK

# The AWS CLI profile for the account the gateway is built in (a role you
# assume, or an SSO / `aws login` profile), and its Region. The Region must
# match `region:` in models.yaml.
export AWS_PROFILE=gateway
export AWS_REGION=us-east-2
export AWS_DEFAULT_REGION="$AWS_REGION"

# CloudFormation stack name; also the prefix of its Parameter Store entries.
export GATEWAY_STACK=llm-gateway
# Empty: https://<elastic ip>.sslip.io. Or a host name whose DNS A record you
# point at the Elastic IP after the first deploy.
export GATEWAY_DOMAIN=
# public: the Admin UI (/ui) is on the internet behind its own password.
# tunnel: only reachable through scripts/tunnel.sh (needs AWS access to use).
export GATEWAY_ADMIN_UI=public

# Workshop sign-up on a JupyterHub (the key service is always deployed, and
# closed until scripts/workshop.py open). The hub script's command name; it
# also names its key folder, ~/.config/<command>, so give a test gateway and a
# production one different names. Never "claude".
export GATEWAY_HUB_COMMAND=claude-workshop
# Where participants run it from, and where an admin copies it to. On many
# hubs these are the same shared folder seen read-only and read-write.
export GATEWAY_HUB_DIR='~/shared/workshop'  # quoted: kept as ~ in the docs
export GATEWAY_HUB_ADMIN_DIR='~/shared-readwrite/workshop'
# Defaults for workshop keys (USD, days, most keys out at once).
export GATEWAY_WORKSHOP_BUDGET=20
export GATEWAY_WORKSHOP_DAYS=7
export GATEWAY_WORKSHOP_MAX=20
# Who participants should ask, as it reads in "ask <organizer>".
export GATEWAY_ORGANIZER="the organizer"

# Python environment for the scripts, if made here (see the skill's deploy steps).
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -f "$_here/.venv/bin/activate" ] && . "$_here/.venv/bin/activate"
unset _here
